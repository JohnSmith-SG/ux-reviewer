# Ключ OpenAI-совместимого API (по умолчанию — ProxyAPI). Или PROXYAPI_KEY_FILE=путь к файлу.
PROXYAPI_KEY=
# Другой адрес API и модель (необязательно)
# OPENAI_BASE_URL=https://openai.api.proxyapi.ru/v1
# UX_MODEL=openai/gpt-4o

# Лимиты веб-сервиса: проверок в сутки с одного адреса и всего
# UX_LIMIT_PER_IP=5
# UX_LIMIT_PER_DAY=60
# Соль для хэша IP посетителей (IP не хранятся в открытом виде)
# UX_IP_SALT=любая-строка
# 1 — сервис за обратным прокси (домен + HTTPS), IP брать из X-Forwarded-For
# UX_TRUST_PROXY=0

# Docker Compose: порт на сервере и пользователь, от которого работает контейнер
# UX_PORT=8080
# UX_UID=10001
# UX_GID=10001
